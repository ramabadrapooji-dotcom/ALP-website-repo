# Backend Environment Variables
# Copy this file to backend/.env and fill in values

# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────────────
# Development (SQLite — relative to backend/)
DATABASE_URL=file:../data/rrb-alp.db

# Production (PostgreSQL — uncomment and fill)
# DATABASE_URL=postgresql://user:password@host:5432/rrb_alp_db

# ─── CORS ─────────────────────────────────────────────
# Development
CORS_ORIGIN=http://localhost:5173

# Production
# CORS_ORIGIN=https://your-vercel-app.vercel.app

# ─── File Uploads ──────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── Future: JWT (when auth is enabled) ──────────────
# JWT_SECRET=change-me-to-a-long-random-secret
# JWT_EXPIRES_IN=7d

# ─── Future: AI API (optional, not required) ──────────
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=

# ─── Future: Object Storage ────────────────────────────
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
